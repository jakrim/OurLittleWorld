# Files excluded from the EAS Build upload archive.
# (We deliberately KEEP assets/images and assets/fonts so RN's
# `assetBundlePatterns: ["**/*"]` works for both dev + production builds.)

node_modules/
.git/
.expo/
.vscode/
.cursor/
.agents/

# Local build artifacts (regenerated by EAS / Xcode)
build/
ios/build/
ios/Pods/
android/build/
android/app/build/
android/.gradle/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Logs / debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store

# Local env / secrets
.env
.env.local
