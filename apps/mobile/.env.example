EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Dedicated Our Little World analytics project. The public capture token is safe
# for clients, but it must not be shared with Get Mentors or LiveVault.
# Analytics remains disabled unless stored consent or the explicit default below
# is "granted".
EXPO_PUBLIC_OUR_LITTLE_WORLD_ANALYTICS_POSTHOG_API_KEY=phc_our_little_world_project_token
EXPO_PUBLIC_OUR_LITTLE_WORLD_ANALYTICS_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_OUR_LITTLE_WORLD_ANALYTICS_ENVIRONMENT=development
EXPO_PUBLIC_OUR_LITTLE_WORLD_ANALYTICS_DEFAULT_CONSENT=unknown

# SDK 56 uses expo/fetch as globalThis.fetch by default. Set to 1 only if Supabase/network calls misbehave.
# EXPO_PUBLIC_USE_RN_FETCH=1

# Optional analytics. Use a token from the dedicated Our Little World PostHog
# project only. Delivery is still blocked until the user explicitly grants
# consent in Settings. Person profiles remain disabled.
# EXPO_PUBLIC_OUR_LITTLE_WORLD_ANALYTICS_POSTHOG_API_KEY=phc_project_token
# EXPO_PUBLIC_OUR_LITTLE_WORLD_ANALYTICS_POSTHOG_HOST=https://us.i.posthog.com
# EXPO_PUBLIC_OUR_LITTLE_WORLD_ANALYTICS_ENVIRONMENT=preview

# Server-side Supabase Edge Function secrets for the dev-login function.
# Set these with `supabase secrets set ...`; do not prefix them with EXPO_PUBLIC.
# DEV_LOGIN_ENABLED=false
# DEV_LOGIN_EMAIL=developer@example.com
# DEV_LOGIN_CODE=000000
# DEV_LOGIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
# DEV_LOGIN_ALLOW_ANY_IP=false
# EXPO_PUBLIC_OLW_DEV_LOGIN_EMAIL=developer@example.com
