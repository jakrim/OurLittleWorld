{
  "name": "@ourlittleworld/mobile",
  "version": "1.0.3",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "npx expo start --dev-client --port 8092",
    "dev:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 npx expo start --dev-client --port 8092",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "db:lint": "cd ../.. && supabase db lint --local --fail-on error",
    "db:reset:migrations": "cd ../.. && supabase db reset --local --no-seed && pnpm db:lint",
    "generate-memories": "node scripts/generate-memories.js",
    "generate-brand": "python3 scripts/generate-brand-assets.py",
    "check:ios-toolchain": "node scripts/check-ios-toolchain.js",
    "sim:seed": "node scripts/seed-simulator-photos.js",
    "sim:seed:small": "node scripts/seed-simulator-photos.js --count 250",
    "sim:shot": "./scripts/sim-screenshot.sh",
    "start": "npx expo start --dev-client --port 8092",
    "start:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 npx expo start --dev-client --port 8092",
    "start:tunnel": "expo start --dev-client --tunnel --port 8092",
    "ios": "node scripts/check-ios-toolchain.js && expo run:ios --port 8092",
    "android": "expo run:android --port 8092",
    "web": "expo start --web --port 8092",
    "build:sim": "node scripts/check-ios-toolchain.js && mkdir -p ./build/simulator && eas build --platform ios --profile development-simulator --local --non-interactive --output ./build/simulator/ourlittleworld-sim.tar.gz",
    "build:device": "node scripts/check-ios-toolchain.js && mkdir -p ./build/device && eas build --platform ios --profile development --local --output ./build/device/ourlittleworld-dev.ipa",
    "build:device:cloud": "eas build --platform ios --profile development",
    "build:android": "mkdir -p ./build/android && eas build --platform android --profile development --local --non-interactive --output ./build/android/ourlittleworld-dev.apk",
    "device:register": "eas device:create",
    "install:sim": "rm -rf ./build/simulator/extracted && mkdir -p ./build/simulator/extracted && tar -xzf ./build/simulator/ourlittleworld-sim.tar.gz -C ./build/simulator/extracted && xcrun simctl install booted ./build/simulator/extracted/OurLittleWorld.app",
    "install:sim:16e": "rm -rf ./build/simulator/extracted && mkdir -p ./build/simulator/extracted && tar -xzf ./build/simulator/ourlittleworld-sim.tar.gz -C ./build/simulator/extracted && SIM_UDID=\"$(xcrun simctl list devices available | awk -F '[()]' '/iPhone 16e / {print $2; exit}')\" && test -n \"$SIM_UDID\" && (xcrun simctl boot \"$SIM_UDID\" 2>/dev/null || true) && xcrun simctl bootstatus \"$SIM_UDID\" -b && xcrun simctl install \"$SIM_UDID\" \"$(find ./build/simulator/extracted -name OurLittleWorld.app -print -quit)\"",
    "dev:cloud-sim": "eas build --platform ios --profile development-simulator --non-interactive",
    "credentials": "eas credentials",
    "eas-build-post-install": "node scripts/eas-build-post-install.js"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/dom-webview": "^56.0.6",
    "@expo/metro-runtime": "^56.0.16",
    "@expo/ui": "~56.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@supabase/supabase-js": "^2.105.4",
    "babel-preset-expo": "~56.0.0",
    "expo": "~56.0.14",
    "expo-asset": "~56.0.18",
    "expo-audio": "~56.0.11",
    "expo-background-task": "~56.0.20",
    "expo-battery": "~56.0.4",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.21",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.20",
    "expo-dev-client": "~56.0.22",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-iap": "4.3.2",
    "expo-image": "~56.0.9",
    "expo-image-manipulator": "~56.0.20",
    "expo-image-picker": "~56.0.19",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-media-library": "~56.0.9",
    "expo-notifications": "~56.0.19",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.13",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.12",
    "expo-sqlite": "~56.0.4",
    "expo-task-manager": "~56.0.20",
    "expo-video": "~56.1.4",
    "expo-video-thumbnails": "~56.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "expo-mcp": "^0.2.4"
  }
}
