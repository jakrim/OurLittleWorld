{
  "name": "ourlittleworld",
  "private": true,
  "scripts": {
    "agent:inventory": "bash scripts/agent/repo-inventory.sh",
    "agent:validate": "bash scripts/agent/validate-context.sh",
    "smoke:mobile": "bash scripts/agent/smoke-mobile.sh",
    "qa:account-deletion:local": "node scripts/qa-account-deletion-local.mjs",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @ourlittleworld/web dev",
    "dev:mobile": "pnpm --filter @ourlittleworld/mobile dev",
    "dev:mobile:mcp": "pnpm --filter @ourlittleworld/mobile start:mcp",
    "build": "turbo build",
    "build:web": "pnpm --filter @ourlittleworld/web build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "ios": "pnpm --filter @ourlittleworld/mobile ios",
    "android": "pnpm --filter @ourlittleworld/mobile android",
    "mobile:web": "pnpm --filter @ourlittleworld/mobile web",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:reset:migrations": "supabase db reset --local --no-seed && pnpm db:lint"
  },
  "devDependencies": {
    "turbo": "^2.9.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  }
}
