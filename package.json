{
  "name": "ourlittleworld",
  "version": "1.0.3",
  "main": "expo-router/entry",
  "scripts": {
    "generate-memories": "node scripts/generate-memories.js",
    "sim:seed": "node scripts/seed-simulator-photos.js",
    "sim:seed:small": "node scripts/seed-simulator-photos.js --count 250",
    "sim:shot": "./scripts/sim-screenshot.sh",
    "start": "expo start --dev-client --port 8092",
    "start:tunnel": "expo start --dev-client --tunnel --port 8092",
    "ios": "expo run:ios --port 8092",
    "android": "expo run:android --port 8092",
    "web": "expo start --web --port 8092",
    "build:sim": "eas build --platform ios --profile development-simulator --local --non-interactive --output ./build/ourlittleworld-sim.tar.gz",
    "build:device": "eas build --platform ios --profile development --non-interactive",
    "device:register": "eas device:create",
    "install:sim": "rm -rf ./build/sim && mkdir -p ./build/sim && tar -xzf ./build/ourlittleworld-sim.tar.gz -C ./build/sim && xcrun simctl install booted ./build/sim/OurLittleWorld.app",
    "credentials": "eas credentials"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/native": "^7.2.4",
    "@supabase/supabase-js": "^2.105.4",
    "babel-preset-expo": "~55.0.8",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~55.0.0",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-dev-client": "~55.0.32",
    "expo-file-system": "~55.0.19",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-image-manipulator": "~55.0.16",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-media-library": "~55.0.16",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.20",
    "expo-sqlite": "~55.0.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "private": true
}
