{
  "name": "ourlittleworld",
  "version": "1.0.3",
  "main": "expo-router/entry",
  "scripts": {
    "generate-memories": "node scripts/generate-memories.js",
    "generate-brand": "python3 scripts/generate-brand-assets.py",
    "sim:seed": "node scripts/seed-simulator-photos.js",
    "sim:seed:small": "node scripts/seed-simulator-photos.js --count 250",
    "sim:shot": "./scripts/sim-screenshot.sh",
    "start": "EXPO_UNSTABLE_MCP_SERVER=1 npx expo start --dev-client --port 8092",
    "start:tunnel": "expo start --dev-client --tunnel --port 8092",
    "ios": "expo run:ios --port 8092",
    "android": "expo run:android --port 8092",
    "web": "expo start --web --port 8092",
    "build:sim": "mkdir -p ./build/simulator && eas build --platform ios --profile development-simulator --local --non-interactive --output ./build/simulator/ourlittleworld-sim.tar.gz",
    "build:device": "mkdir -p ./build/device && eas build --platform ios --profile development --local --output ./build/device/ourlittleworld-dev.ipa",
    "build:device:cloud": "eas build --platform ios --profile development",
    "device:register": "eas device:create",
    "install:sim": "rm -rf ./build/simulator/extracted && mkdir -p ./build/simulator/extracted && tar -xzf ./build/simulator/ourlittleworld-sim.tar.gz -C ./build/simulator/extracted && xcrun simctl install booted ./build/simulator/extracted/OurLittleWorld.app",
    "install:sim:16e": "rm -rf ./build/simulator/extracted && mkdir -p ./build/simulator/extracted && (test -f ./build/simulator/ourlittleworld-sim-sdk56.tar.gz && tar -xzf ./build/simulator/ourlittleworld-sim-sdk56.tar.gz || tar -xzf ./build/simulator/ourlittleworld-sim.tar.gz) -C ./build/simulator/extracted && xcrun simctl install DF0B3E65-8508-431F-9CD3-B9DF63DE1393 \"$(find ./build/simulator/extracted -name OurLittleWorld.app -print -quit)\"",
    "dev:cloud-sim": "eas build --platform ios --profile development-simulator --non-interactive",
    "credentials": "eas credentials"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/ui": "~56.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@supabase/supabase-js": "^2.105.4",
    "babel-preset-expo": "~56.0.0",
    "expo": "^56.0.4",
    "expo-asset": "~56.0.14",
    "expo-audio": "~56.0.10",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.14",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.15",
    "expo-dev-client": "~56.0.15",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-manipulator": "~56.0.14",
    "expo-image-picker": "~56.0.13",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-media-library": "~56.0.6",
    "expo-router": "~56.2.6",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "private": true
}
